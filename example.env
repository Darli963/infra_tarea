# ====================================================
# CONFIGURACIÓN GENERAL
# ====================================================
# Qué hace Docker si el contenedor se apaga solo
RESTART_POLICY=unless-stopped

# ====================================================
# APLICACIÓN (BACKEND Y FRONTEND)
# ====================================================
# Backend (Puerto de red y nombre)
BACKEND_PORT=3001
BACKEND_CONTAINER_NAME=lab-backend

# Frontend (Puerto de red y nombre)
FRONTEND_PORT=8080
FRONTEND_CONTAINER_NAME=lab-frontend

# Dirección interna para que el frontend hable con el backend
BACKEND_URL=http://backend:3001

# ====================================================
# MONITOREO (MÉTRICAS)
# ====================================================
# Prometheus (Base de datos de métricas)
PROMETHEUS_PORT=9090
PROMETHEUS_CONTAINER_NAME=lab-prometheus
PROMETHEUS_VERSION=v3.8.1

# Node Exporter (Mide uso de CPU y RAM del servidor)
NODE_EXPORTER_PORT=9100
NODE_EXPORTER_CONTAINER_NAME=lab-node-exporter
NODE_EXPORTER_VERSION=v1.8.2

# cAdvisor (Mide uso de CPU y RAM de cada contenedor)
CADVISOR_PORT=8081
CADVISOR_CONTAINER_NAME=lab-cadvisor
CADVISOR_VERSION=v0.49.1

# ====================================================
# RECOLECCIÓN DE LOGS
# ====================================================
# Loki (Base de datos para guardar los logs)
LOKI_PORT=3100
LOKI_CONTAINER_NAME=lab-loki
LOKI_VERSION=3.4.0

# Alloy (Envía los logs hacia Loki)
ALLOY_PORT=12345
ALLOY_CONTAINER_NAME=lab-alloy
ALLOY_VERSION=v1.10.0

# ====================================================
# VISUALIZACIÓN (GRAFANA)
# ====================================================
# Panel visual (Puerto de red y nombre)
GRAFANA_PORT=3000
GRAFANA_CONTAINER_NAME=lab-grafana
GRAFANA_VERSION=11.5.0

# Usuario y contraseña para entrar a Grafana
GF_SECURITY_ADMIN_USER=nombre_administrador
GF_SECURITY_ADMIN_PASSWORD=contrasena_segura_acceso!

# Apariencia de la interfaz (dark = oscuro, light = claro)
GF_USERS_DEFAULT_THEME=dark
